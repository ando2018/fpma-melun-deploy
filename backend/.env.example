# Copier ce fichier en .env et renseigner vos identifiants SMTP pour activer
# l'envoi réel des mails du formulaire de contact. Sans ça, les messages sont
# quand même enregistrés dans src/data/messages.json, mais aucun mail n'est envoyé.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=votre-adresse@example.com
SMTP_PASS=votre-mot-de-passe-ou-app-password
MAIL_TO=fpmamelun77@gmail.com

# Port d'écoute du serveur (optionnel, 3000 par défaut)
PORT=3000

# URL publique de base du backend. Sert à construire les URLs absolues des fichiers
# uploadés (images vaovao/évènements/sary) dans les réponses de l'API. Sans cette
# variable, elle serait déduite automatiquement de chaque requête (protocole + host) ;
# ici on la fixe explicitement sur le vrai domaine de production.
PUBLIC_BASE_URL=https://fpma-melun.org

# Secret de signature des sessions admin (longue chaîne aléatoire). Sans cette
# variable, un secret est généré à chaque démarrage et les utilisateurs connectés
# doivent se reconnecter après un redémarrage du serveur.
AUTH_SECRET=remplacer-par-une-longue-chaine-aleatoire

# Clés des notifications push (Web Push). Facultatif : sans ces variables, des clés sont
# générées automatiquement au premier démarrage et gardées dans la base. Ne jamais
# changer les clés ensuite, sinon tous les abonnements existants cessent de fonctionner.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:fpmamelun77@gmail.com

# Nombre maximum de spectateurs simultanés du direct vidéo (limité par le débit montant
# de la connexion de l appareil qui filme, environ 1 Mbit/s par spectateur).
# LIVE_MAX_VIEWERS=25

# Base de données MongoDB (obligatoire). Par défaut : MongoDB installé sur ce même
# serveur, base « fpma ».
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=fpma

# Import des anciens fichiers JSON (src/data) au démarrage sur une base vide : désactivé
# par défaut (pm2 restart ne recharge jamais ces données). Pour l'import initial, mettre
# true une fois, ou lancer « npm run import-json ».
# IMPORT_JSON_ON_START=false

# Sauvegardes automatiques de la base (toutes les heures, surveillance et restauration si
# la base est vidée). Activées par défaut ; mettre false pour les désactiver.
# BACKUP_ENABLED=true
# BACKUP_KEEP=5
# DB_WATCH_SECONDS=10800
# BACKUP_DIR=/chemin/vers/backups

# Dossier du site Angular compilé (dist). Le backend s en sert pour ajouter le titre et
# l image des aperçus de partage (articles, albums). En production avec Apache :
# FRONTEND_DIST_PATH=/var/www/fpma-melun
